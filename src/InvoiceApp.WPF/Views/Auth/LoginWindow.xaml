<Window x:Class="InvoiceApp.WPF.Views.Auth.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:conv="clr-namespace:InvoiceApp.WPF.Converters"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="InvoiceApp — Iniciar Sesión"
        Width="960" Height="600"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}">

    <Window.Resources>
        <conv:LoadingConverter x:Key="LoadingConverter"/>
        <conv:BoolInverseConverter x:Key="BoolInverseConverter"/>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Panel decorativo Izquierdo -->
            <ColumnDefinition Width="*"/>
            <!-- Panel Formulario Derecho -->
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL — Brand Minimalista -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}">
            <Grid>
                <!-- Detalle sutil de fondo para textura -->
                <Ellipse Fill="{StaticResource SecondaryBrush}" Opacity="0.05" Width="500" Height="500" Margin="-200,-300,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Ellipse Fill="{StaticResource PrimaryBrush}" Opacity="0.03" Width="600" Height="600" Margin="0,0,-200,-200" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
                    <!-- Icono en Mostaza / Naranja -->
                    <TextBlock Text="🧾" FontSize="72" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="InvoiceApp" FontSize="36" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Sistema de Facturación Simple" FontSize="15"
                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,48"/>

                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="12" Padding="24"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6">
                                <TextBlock Text="✓" Foreground="{StaticResource SecondaryBrush}" FontWeight="Bold" Margin="0,0,12,0" FontSize="14"/>
                                <TextBlock Text="Facturación digital rápida" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6">
                                <TextBlock Text="✓" Foreground="{StaticResource SecondaryBrush}" FontWeight="Bold" Margin="0,0,12,0" FontSize="14"/>
                                <TextBlock Text="Gestión de clientes intuitiva" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6">
                                <TextBlock Text="✓" Foreground="{StaticResource SecondaryBrush}" FontWeight="Bold" Margin="0,0,12,0" FontSize="14"/>
                                <TextBlock Text="Exportación de reportes PDF" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- RIGHT PANEL — Login Form -->
        <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" 
                CornerRadius="24,0,0,24" 
                Effect="{x:Null}">
            <!-- Separador visual -->
            <Border.BorderBrush>
                <SolidColorBrush Color="#E2E8F0" Opacity="0.6"/>
            </Border.BorderBrush>
            <Border.BorderThickness>1,0,0,0</Border.BorderThickness>

            <StackPanel VerticalAlignment="Center" Margin="48,0">
                <TextBlock Text="¡Hola de nuevo!" FontSize="28" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                <TextBlock Text="Ingresa tus credenciales para continuar"
                           FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,40"/>

                <!-- Error Message -->
                <Border Background="#FFF5F5" CornerRadius="8" Padding="16,12"
                        Margin="0,0,0,24" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠️" Foreground="{StaticResource DangerBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding ErrorMessage}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Email -->
                <TextBlock Text="CORREO ELECTRÓNICO" Style="{StaticResource FormLabelStyle}"/>
                <TextBox x:Name="EmailTextBox" Style="{StaticResource FormTextBoxStyle}"
                         Margin="0,0,0,20"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Password -->
                <TextBlock Text="CONTRASEÑA" Style="{StaticResource FormLabelStyle}"/>
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource FormPasswordBoxStyle}"
                             Margin="0,0,0,36" PasswordChanged="PasswordBox_PasswordChanged"/>

                <!-- Login Button -->
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding LoginCommand}"
                        HorizontalAlignment="Stretch" Margin="0,0,0,24">
                    <TextBlock>
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}">
                                <Binding Path="IsLoading" Converter="{StaticResource LoadingConverter}"
                                         ConverterParameter="INICIANDO SESIÓN...|INICIAR SESIÓN"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="¿No tienes empresa registrada? " FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Button Style="{StaticResource LinkButtonStyle}"
                            Content="Regístrate aquí"
                            Command="{Binding GoToRegisterCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
