<Window x:Class="InvoiceApp.WPF.Views.Auth.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:conv="clr-namespace:InvoiceApp.WPF.Converters"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="InvoiceApp — Iniciar Sesión"
        Width="960" Height="600"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <conv:LoadingConverter x:Key="LoadingConverter"/>
        <conv:BoolInverseConverter x:Key="BoolInverseConverter"/>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL — Brand -->
        <Border Grid.Column="0" Background="{StaticResource PrimaryBrush}">
            <Grid>
                <Rectangle Opacity="0.15">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#6366F1" Offset="0"/>
                            <GradientStop Color="#10B981" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
                    <TextBlock Text="🧾" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="InvoiceApp" FontSize="34" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Sistema de Facturación Enterprise" FontSize="14"
                               Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,8,0,40"/>

                    <Border Background="#FFFFFF14" CornerRadius="8" Padding="20,14">
                        <StackPanel>
                            <TextBlock Text="✓  Facturación digital rápida" Foreground="#CBD5E1" FontSize="13" Margin="0,4"/>
                            <TextBlock Text="✓  Gestión de clientes y pagos" Foreground="#CBD5E1" FontSize="13" Margin="0,4"/>
                            <TextBlock Text="✓  Reportes e impuestos" Foreground="#CBD5E1" FontSize="13" Margin="0,4"/>
                            <TextBlock Text="✓  Exportar PDF y envío por email" Foreground="#CBD5E1" FontSize="13" Margin="0,4"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- RIGHT PANEL — Login Form -->
        <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}">
            <StackPanel VerticalAlignment="Center" Margin="48,0">
                <TextBlock Text="Bienvenido de vuelta" FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                <TextBlock Text="Ingresa tus credenciales para continuar"
                           FontSize="13" Foreground="#64748B" Margin="0,0,0,32"/>

                <!-- Error Message -->
                <Border Background="#FEF2F2" CornerRadius="6" Padding="12,10"
                        Margin="0,0,0,16"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" FontSize="13" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Email -->
                <TextBlock Text="CORREO ELECTRÓNICO" Style="{StaticResource FormLabelStyle}"/>
                <TextBox x:Name="EmailTextBox" Style="{StaticResource FormTextBoxStyle}"
                         Margin="0,0,0,16"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Password -->
                <TextBlock Text="CONTRASEÑA" Style="{StaticResource FormLabelStyle}"/>
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource FormPasswordBoxStyle}"
                             Margin="0,0,0,28" PasswordChanged="PasswordBox_PasswordChanged"/>

                <!-- Login Button -->
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding LoginCommand}"
                        HorizontalAlignment="Stretch" Height="44" Margin="0,0,0,20">
                    <TextBlock>
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}">
                                <Binding Path="IsLoading" Converter="{StaticResource LoadingConverter}"
                                         ConverterParameter="INICIANDO SESIÓN...|INICIAR SESIÓN"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="¿No tienes empresa registrada? " FontSize="13" Foreground="#64748B"/>
                    <Button Style="{StaticResource LinkButtonStyle}"
                            Content="Regístrate aquí"
                            Command="{Binding GoToRegisterCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
