<Window x:Class="InvoiceApp.WPF.Views.Auth.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:conv="clr-namespace:InvoiceApp.WPF.Converters"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="InvoiceApp — Registrar Empresa"
        Width="560" Height="740"
        MinWidth="560" MinHeight="740"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}">

    <Window.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <conv:BoolInverseConverter x:Key="BoolInverseConverter"/>
    </Window.Resources>

    <!-- Envoltura principal crema -->
    <Border Background="{StaticResource SurfaceBrush}">
        <!-- Detalles visuales de fondo (círculos tenues) -->
        <Grid>
            <Ellipse Fill="{StaticResource PrimaryBrush}" Opacity="0.04" Width="400" Height="400" Margin="-150,-150,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40">
                <StackPanel>
                    <!-- Header -->
                    <TextBlock Text="🏢" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="Registrar Nueva Empresa" FontSize="26" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="Completa la información para configurar tu sistema" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,32"/>

                    <!-- Status Messages -->
                    <Border Background="#FFF5F5" CornerRadius="8" Padding="16,12"
                            Margin="0,0,0,20" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️" Foreground="{StaticResource DangerBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding ErrorMessage}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Background="#F0FDF4" CornerRadius="8" Padding="16,12"
                            Margin="0,0,0,20" BorderBrush="#16A34A" BorderThickness="1"
                            Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✅" Foreground="#16A34A" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding SuccessMessage}" FontSize="13" Foreground="#15803D" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Section: Datos empresa (Tarjeta Blanca) -->
                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="12" Padding="24" Margin="0,0,0,24"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Border Background="{StaticResource SecondaryBrush}" Width="4" Height="16" CornerRadius="2" Margin="0,0,8,0"/>
                                <TextBlock Text="DATOS DE LA EMPRESA" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <TextBlock Text="NOMBRE EMPRESA" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,16"/>

                            <TextBlock Text="NIT / IDENTIFICACIÓN FISCAL" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding TaxId, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Section: Datos admin (Tarjeta Blanca) -->
                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="12" Padding="24" Margin="0,0,0,32"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Border Background="{StaticResource PrimaryBrush}" Width="4" Height="16" CornerRadius="2" Margin="0,0,8,0"/>
                                <TextBlock Text="DATOS DEL ADMINISTRADOR" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <TextBlock Text="NOMBRE COMPLETO" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding AdminFullName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,16"/>

                            <TextBlock Text="CORREO ELECTRÓNICO" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding AdminEmail, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,16"/>

                            <TextBlock Text="CONTRASEÑA" Style="{StaticResource FormLabelStyle}"/>
                            <PasswordBox x:Name="PasswordBox" Style="{StaticResource FormPasswordBoxStyle}"
                                         PasswordChanged="PasswordBox_PasswordChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- Buttons -->
                    <Button Content="CREAR EMPRESA" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding RegisterCommand}"
                            HorizontalAlignment="Stretch" Margin="0,0,0,16"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource BoolInverseConverter}}"/>
                            
                    <Button Content="Cancelar y volver al Login" Style="{StaticResource GhostButtonStyle}"
                            Click="CancelButton_Click"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
