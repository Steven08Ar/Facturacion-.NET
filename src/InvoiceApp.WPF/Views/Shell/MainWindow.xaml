<Window x:Class="InvoiceApp.WPF.Views.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="InvoiceApp Enterprise"
        Width="1280" Height="800"
        MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════ SIDEBAR ═══════ -->
        <Border Grid.Column="0" Background="{StaticResource PrimaryBrush}">
            <DockPanel>

                <!-- Logo -->
                <Border DockPanel.Dock="Top" Padding="20,28,20,20" BorderBrush="#FFFFFF14" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="🧾 InvoiceApp" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Sistema Enterprise" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- User Info -->
                <Border DockPanel.Dock="Bottom" Padding="16,14" BorderBrush="#FFFFFF14" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{StaticResource SecondaryBrush}">
                            <TextBlock Text="A" Foreground="White" FontWeight="Bold" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="{Binding CurrentUser}" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Administrador" Foreground="#64748B" FontSize="11"/>
                        </StackPanel>

                        <Button Grid.Column="2" Content="↩" Foreground="#64748B" Background="Transparent"
                                BorderThickness="0" FontSize="18" Cursor="Hand"
                                Command="{Binding LogoutCommand}" ToolTip="Cerrar sesión"/>
                    </Grid>
                </Border>

                <!-- Navigation Menu -->
                <StackPanel DockPanel.Dock="Top" Margin="0,16,0,0">
                    <TextBlock Text="PRINCIPAL" FontSize="10" FontWeight="Bold" Foreground="#475569"
                               Margin="20,0,0,8"/>

                    <Button Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateToDashboardCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Dashboard"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="GESTIÓN" FontSize="10" FontWeight="Bold" Foreground="#475569"
                               Margin="20,16,0,8"/>

                    <Button Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateToCustomersCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👥" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Clientes"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateToProductsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📦" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Productos"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateToInvoicesCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧾" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Facturas"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateToPaymentsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💳" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Pagos"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="ANÁLISIS" FontSize="10" FontWeight="Bold" Foreground="#475569"
                               Margin="20,16,0,8"/>

                    <Button Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateToReportsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📈" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Reportes"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateToSettingsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Configuración"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ═══════ MAIN CONTENT AREA ═══════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Bar -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="28,0">
                <Grid>
                    <TextBlock Text="{Binding CurrentModule}" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontSize="13" Foreground="#94A3B8">
                        <TextBlock.Text>
                            <Binding Source="{x:Static sys:DateTime.Now}" StringFormat="{}{0:dddd, d MMMM yyyy}"/>
                        </TextBlock.Text>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Content Placeholder -->
            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" Padding="28">
                <Border Background="White" CornerRadius="12" Padding="32">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🚀" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock Text="{Binding CurrentModule}" FontSize="28" FontWeight="Bold"
                                   HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="Módulo disponible próximamente"
                                   HorizontalAlignment="Center" Foreground="#94A3B8" FontSize="14"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
